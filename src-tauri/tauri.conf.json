{
  "productName": "PteroHub",
  "version": "0.4.1",
  "identifier": "bond.vexel.pterohub",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PteroHub",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost wss:"
    }
  },
  "bundle": {
    "active": false
  }
}